From dfcab86a99994158ae99fe71fe125688e513ba7d Mon Sep 17 00:00:00 2001
From: Alsey Coleman Miller <alseycmiller@gmail.com>
Date: Tue, 23 Jun 2026 10:28:51 -0400
Subject: [Embedded] Add Armv5TE to list of 32-bit architectures


Upstream: https://github.com/swiftlang/swift/pull/90023 (merged to main after swift-6.3.3-RELEASE)
Signed-off-by: Alsey Coleman Miller <alseycmiller@gmail.com>
---
 cmake/modules/SwiftSetIfArchBitness.cmake | 1 +
 1 file changed, 1 insertion(+)

diff --git a/cmake/modules/SwiftSetIfArchBitness.cmake b/cmake/modules/SwiftSetIfArchBitness.cmake
index a4b54574e64ca..41eceeec3bccd 100644
--- a/cmake/modules/SwiftSetIfArchBitness.cmake
+++ b/cmake/modules/SwiftSetIfArchBitness.cmake
@@ -13,6 +13,7 @@ function(set_if_arch_bitness var_name)
      "${SIA_ARCH}" STREQUAL "x86" OR
      "${SIA_ARCH}" STREQUAL "armv4t" OR
      "${SIA_ARCH}" STREQUAL "armv5" OR
+     "${SIA_ARCH}" STREQUAL "armv5te" OR
      "${SIA_ARCH}" STREQUAL "armv6" OR
      "${SIA_ARCH}" STREQUAL "armv6m" OR
      "${SIA_ARCH}" STREQUAL "armv7" OR
