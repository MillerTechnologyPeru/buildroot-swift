From 1a2b3c4d5e6f0000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alsey Coleman Miller <alseycmiller@gmail.com>
Date: Fri, 10 Jul 2026 05:45:00 -0400
Subject: [PATCH] Provide Float16 conversion helpers on powerpc64le

Float16Support.cpp already implements the soft-float helpers
__truncsfhf2 / __extendhfsf2 / __truncdfhf2, but its guard only enables
them for x86 and ARM. powerpc64le has no hardware Float16, and its libgcc
does not supply these helpers, so libswiftCore.so ends up referencing
them as undefined symbols. Every executable that links libswiftCore.so
then fails at link time (e.g. swift-hello built with C++ interop) with
"undefined reference: __truncsfhf2".

The implementations only touch _Float16 through memcpy, so they compile
and run correctly on powerpc64le. Enable them for __powerpc64__ so that
libswiftCore defines the helpers.
---
 stdlib/public/runtime/Float16Support.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/stdlib/public/runtime/Float16Support.cpp b/stdlib/public/runtime/Float16Support.cpp
index 1111111111..2222222222 100644
--- a/stdlib/public/runtime/Float16Support.cpp
+++ b/stdlib/public/runtime/Float16Support.cpp
@@ -31,7 +31,7 @@
 // Android NDK <r21 do not provide `__aeabi_d2h` in the compiler runtime,
 // provide shims in that case.
 #if (defined(__ANDROID__) && defined(__ARM_ARCH_7A__) && defined(__ARM_EABI__)) || \
-  ((defined(__i386__) || defined(__i686__) || defined(__arm__) || defined(__x86_64__)) && !defined(__APPLE__))
+  ((defined(__i386__) || defined(__i686__) || defined(__arm__) || defined(__x86_64__) || defined(__powerpc64__)) && !defined(__APPLE__))

 #include "swift/shims/Visibility.h"

--
