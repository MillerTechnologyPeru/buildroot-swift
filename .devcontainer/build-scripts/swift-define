# Configurable
WORKING_DIR="${WORKING_DIR:=$(pwd)}"
SWIFT_BUILDROOT="${SWIFT_BUILDROOT:=$(pwd)}"
SWIFT_TARGET_ARCH="${SWIFT_TARGET_ARCH:=arm64}"
BUILDROOT_RELEASE="${BUILDROOT_RELEASE:=2026.05}"
SWIFT_BRANCH="${SWIFT_BRANCH:=swift-6.3.3-release}"
SWIFT_VERSION="${SWIFT_VERSION:=swift-6.3.3-RELEASE}"
SWIFT_PLATFORM="${SWIFT_PLATFORM:=debian12}"

# Allow buildroot host packages (tar) to configure when running as root,
# e.g. inside docker build and CI containers
export FORCE_UNSAFE_CONFIGURE=1

# Defines
BUILDROOT_DEFCONFIG=swift_${SWIFT_TARGET_ARCH}_defconfig
BUILDROOT_DIR=$WORKING_DIR/buildroot
BR2_EXTERNAL=$SWIFT_BUILDROOT
# Overridable so a caller that keeps its output tree somewhere other than
# WORKING_DIR/output/<arch> can still use these scripts. CI builds into a
# persistent directory on the runner's own disk (O=/mnt/br/shared), which no
# combination of WORKING_DIR and SWIFT_TARGET_ARCH can spell.
BUILDROOT_OUTPUT="${BUILDROOT_OUTPUT:=$WORKING_DIR/output/$SWIFT_TARGET_ARCH}"
BUILDROOT_TARGET=$BUILDROOT_OUTPUT/target
BUILDROOT_CONFIG=$BUILDROOT_OUTPUT/.config
BUILDROOT_OPTIONS="O=$BUILDROOT_OUTPUT -C $BUILDROOT_DIR BR2_EXTERNAL=$BR2_EXTERNAL"
HOST_SWIFT_SRCDIR=$BUILDROOT_OUTPUT/build/host-swift-6.3.3
SWIFT_LLVM_BUILD_DIR=$HOST_SWIFT_SRCDIR/swift-source/build/buildbot_linux/llvm-linux-$(uname -m)
HOST_SWIFT_BUILDDIR=$HOST_SWIFT_SRCDIR/build
SWIFT_NATIVE_TOOLS=$HOST_SWIFT_BUILDDIR/usr/bin
SWIFT_LLVM_DIR=$HOST_SWIFT_BUILDDIR/llvm
DOCKER_FILE=$SWIFT_BUILDROOT/.devcontainer/Dockerfile
# qemu-user names its binaries after the CPU, not after our defconfig, and the
# two only coincide for x86_64 and riscv64. Spell every target out rather than
# deriving it: the old fallback produced names like qemu-arm64-static and
# qemu-x86_64_musl-static, which simply do not exist.
case "$SWIFT_TARGET_ARCH" in
   arm64)              QEMU_BIN=qemu-aarch64-static ;;
   armv5|armv6|armv7)  QEMU_BIN=qemu-arm-static ;;
   x86_64|x86_64_musl) QEMU_BIN=qemu-x86_64-static ;;
   i386)               QEMU_BIN=qemu-i386-static ;;
   ppc)                QEMU_BIN=qemu-ppc-static ;;
   ppc64le)            QEMU_BIN=qemu-ppc64le-static ;;
   *)                  QEMU_BIN=qemu-$SWIFT_TARGET_ARCH-static ;;
esac
